{
  "buildCommand": "npm run build && npm run site:build && node tools/deploy/build-vercel.mjs",
  "outputDirectory": "deploy",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/dict/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ],
  "rewrites": [{ "source": "/app/(.*)", "destination": "/app/index.html" }]
}
