{
  "name": "anaru",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "description": "Learn Japanese by watching anime. Free, offline, on every platform.",
  "scripts": {
    "predev": "node scripts/copy-kuromoji-dict.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-kuromoji-dict.mjs",
    "build": "tsc -b && vite build --base /app/",
    "build:app": "tsc -b && vite build --base ./",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dict:build": "node scripts/build-dictionary.mjs",
    "site:build": "node tools/site/build-learn.mjs",
    "icons:build": "python3 tools/icons/build.py",
    "pack": "node tools/pack/build-pack.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tauri-apps/api": "^2.11.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "kuromoji": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild": true
  }
}
