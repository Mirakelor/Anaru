{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anaru",
  "version": "0.1.18",
  "identifier": "com.anaru.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anaru — Learn Japanese by watching anime",
        "width": 480,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
